# Copy to .env.local and fill in. .env.local is git-ignored.

# Canonical origin used in sitemap, canonical tags and structured data.
NEXT_PUBLIC_SITE_URL=https://indiatravelshield.com

# AdSense in-content unit id (the numeric "data-ad-slot" value from
# AdSense > Ads > By ad unit > Display ads). Leave empty to show no manual unit.
NEXT_PUBLIC_ADSENSE_SLOT_INCONTENT=
